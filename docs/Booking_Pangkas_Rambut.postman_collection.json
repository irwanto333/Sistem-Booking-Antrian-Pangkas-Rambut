    "item": [
        {
            "name": "Public",
            "item": [
                {
                    "name": "Get All Active Services",
                    "request": {
                        "method": "GET",
                        "header": [
                            { "key": "Accept", "value": "application/json" }
                        ],
                        "url": {
                            "raw": "{{base_url}}/services",
                            "host": ["{{base_url}}"],
                            "path": ["services"]
                        }
                    }
                },
                {
                    "name": "Get All Active Tukang Cukur",
                    "request": {
                        "method": "GET",
                        "header": [
                            { "key": "Accept", "value": "application/json" }
                        ],
                        "url": {
                            "raw": "{{base_url}}/tukang-cukurs",
                            "host": ["{{base_url}}"],
                            "path": ["tukang-cukurs"]
                        }
                    }
                },
                {
                    "name": "Get Available Schedules",
                    "request": {
                        "method": "GET",
                        "header": [
                            { "key": "Accept", "value": "application/json" }
                        ],
                        "url": {
                            "raw": "{{base_url}}/schedules/available?date={{booking_date}}&tukang_cukur_id={{tukang_cukur_id}}",
                            "host": ["{{base_url}}"],
                            "path": ["schedules", "available"],
                            "query": [
                                { "key": "date", "value": "{{booking_date}}" },
                                {
                                    "key": "tukang_cukur_id",
                                    "value": "{{tukang_cukur_id}}"
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "Create Booking",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "var json = pm.response.json();",
                                    "if (json.success && json.data && json.data.booking_code) {",
                                    "    pm.environment.set('booking_code', json.data.booking_code);",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            { "key": "Accept", "value": "application/json" },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"customer_name\": \"John Doe\",\n    \"customer_phone\": \"{{customer_phone}}\",\n    \"tukang_cukur_id\": {{tukang_cukur_id}},\n    \"service_id\": {{service_id}},\n    \"booking_date\": \"{{booking_date}}\",\n    \"booking_time\": \"10:00\",\n    \"notes\": \"Potong rapi\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/bookings",
                            "host": ["{{base_url}}"],
                            "path": ["bookings"]
                        }
                    }
                },
                {
                    "name": "Check Booking Status",
                    "request": {
                        "method": "GET",
                        "header": [
                            { "key": "Accept", "value": "application/json" }
                        ],
                        "url": {
                            "raw": "{{base_url}}/bookings/{{booking_code}}/status",
                            "host": ["{{base_url}}"],
                            "path": ["bookings", "{{booking_code}}", "status"]
                        }
                    }
                },
                {
                    "name": "Cancel Booking",
                    "request": {
                        "method": "POST",
                        "header": [
                            { "key": "Accept", "value": "application/json" },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"customer_phone\": \"{{customer_phone}}\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/bookings/{{booking_code}}/cancel",
                            "host": ["{{base_url}}"],
                            "path": ["bookings", "{{booking_code}}", "cancel"]
                        }
                    }
                },
                {
                    "name": "Get Today Queue",
                    "request": {
                        "method": "GET",
                        "header": [
                            { "key": "Accept", "value": "application/json" }
                        ],
                        "url": {
                            "raw": "{{base_url}}/queue/today",
                            "host": ["{{base_url}}"],
                            "path": ["queue", "today"]
                        }
                    }
                }
            ]
